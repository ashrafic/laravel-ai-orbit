{
    "name": "ashrafic/laravel-ai-orbit",
    "description": "The Intelligent Control Tower for Laravel AI SDK.",
    "keywords": [
        "laravel",
        "ai",
        "orbit",
        "observability",
        "agent",
        "playground",
        "arena",
        "audit",
        "analytics",
        "debugging",
        "export",
        "prompts",
        "pricing",
        "monitoring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ashrafic Labs",
            "email": "hello@ashraficlabs.com",
            "homepage": "https://ashraficlabs.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.3",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3.0",
        "pestphp/pest": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Ashrafic\\AiOrbit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ashrafic\\AiOrbit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashrafic\\AiOrbit\\OrbitServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
